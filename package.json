{
  "name": "aristodromos",
  "version": "1.0.0",
  "description": "A browser extension whose agent pursues a goal on the web: it reads the page, decides, acts, and adapts.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "start:firefox": "wxt build -b firefox && mkdir -p \"$HOME/.cache/aristodromos\" && web-ext run --source-dir .output/firefox-mv3 --firefox-profile \"$HOME/.cache/aristodromos/firefox-profile\" --profile-create-if-missing --keep-profile-changes --no-reload --pref extensions.webextensions.keepStorageOnUninstall=true --pref extensions.webextensions.keepUuidOnUninstall=true",
    "compile": "wxt build",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm e2e:chromium && pnpm e2e:firefox && pnpm e2e:slow-brain",
    "e2e:chromium": "wxt build && node e2e/run.ts",
    "e2e:firefox": "wxt zip -b firefox && E2E_BROWSER=firefox node e2e/run.ts",
    "e2e:slow-brain": "wxt zip -b firefox && E2E_BROWSER=firefox E2E_STUB_DELAY_MS=45000 node e2e/run.ts",
    "demo": "wxt build && E2E_BRAIN=ollama E2E_HEADED=1 node e2e/run.ts",
    "demo:firefox": "wxt zip -b firefox && E2E_BROWSER=firefox E2E_BRAIN=ollama E2E_HEADED=1 node e2e/run.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "cpd": "jscpd --min-lines 10 --min-tokens 50 --pattern '{utils,entrypoints}/**/*.{ts,tsx}'",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@webext-core/fake-browser": "1.3.4",
    "jscpd": "^4.2.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "playwright-core": "^1.57.0",
    "selenium-webdriver": "^4.52.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6",
    "web-ext": "^10.8.0",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/otel": "^1.0.137",
    "@andypf/json-viewer": "^2.8.0",
    "@arizeai/openinference-core": "^2.8.0",
    "@arizeai/openinference-semantic-conventions": "^2.14.0",
    "@arizeai/openinference-vercel": "^3.3.0",
    "@gavmor/skene": "https://github.com/gavmor/skene/releases/download/v0.2.1/gavmor-skene-0.2.1.tgz",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.73.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "preact": "^11.2.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  }
}

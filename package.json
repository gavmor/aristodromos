{
  "name": "aristodromos",
  "version": "1.0.0",
  "description": "A browser extension whose agent pursues a goal on the web: it reads the page, decides, acts, and adapts.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "compile": "wxt build",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && node e2e/run.ts",
    "e2e:firefox": "wxt zip -b firefox && E2E_BROWSER=firefox node e2e/run.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "cpd": "jscpd --min-lines 10 --min-tokens 50 --pattern 'utils/**/*.ts'",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/selenium-webdriver": "^4.35.7",
    "@webext-core/fake-browser": "1.3.4",
    "jscpd": "^4.2.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "playwright-core": "^1.57.0",
    "selenium-webdriver": "^4.52.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6",
    "web-ext": "^10.8.0",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.137",
    "@andypf/json-viewer": "^2.8.0",
    "@arizeai/openinference-core": "^2.8.0",
    "@arizeai/openinference-semantic-conventions": "^2.14.0",
    "@arizeai/openinference-vercel": "^3.3.0",
    "@gavmor/skene": "https://github.com/gavmor/skene/releases/download/v0.2.1/gavmor-skene-0.2.1.tgz",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ai": "^7.0.137",
    "ollama-ai-provider-v2": "^4.0.1"
  }
}

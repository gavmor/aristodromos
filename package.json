{
  "name": "aristrodomos",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt build",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && node e2e/run.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "cpd": "jscpd --min-lines 10 --min-tokens 50 --pattern 'utils/**/*.ts'",
    "eval:gate": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c evals/promptfoo/promptfooconfig.yaml --filter-providers deterministic --no-cache",
    "eval:bakeoff": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c evals/promptfoo/promptfooconfig.yaml --no-cache"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "@webext-core/fake-browser": "1.3.4"
    }
  },
  "devDependencies": {
    "@webext-core/fake-browser": "1.3.4",
    "jscpd": "^4.2.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "playwright-core": "^1.57.0",
    "promptfoo": "0.124.1",
    "vitest": "^4.1.6",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "ai": "^7.0.137",
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1",
    "fast-json-patch": "^3.1.1",
    "ollama-ai-provider-v2": "^4.0.1",
    "zod": "^4.6.5"
  }
}
